{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fixture.shouter",
  "description": "Test fixture: a paragraph that sets inline visibility: visible on itself (on purpose).",
  "type": "object",
  "additionalProperties": false,
  "required": ["text"],
  "properties": {
    "text": {
      "type": "string",
      "description": "The text of the paragraph.",
      "examples": ["Here I am"],
      "x-transition": "snap"
    }
  }
}
