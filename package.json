{
  "name": "stepdeck",
  "version": "0.1.0",
  "private": true,
  "description": "Declarative step-by-step HTML presentation engine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/horaciochacon/stepdeck.git"
  },
  "homepage": "https://horaciochacon.github.io/stepdeck/",
  "bugs": {
    "url": "https://github.com/horaciochacon/stepdeck/issues"
  },
  "keywords": [
    "presentations",
    "slides",
    "html",
    "data-visualization",
    "d3"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.15",
      "onFail": "warn"
    }
  },
  "bin": {
    "stepdeck": "cli/index.js"
  },
  "imports": {
    "#engine/*": "./engine/*"
  },
  "scripts": {
    "test": "node --test 'test/unit/**/*.test.mjs'",
    "test:browser": "node --test --test-concurrency=6 'test/browser/**/*.test.mjs'",
    "test:all": "npm test && npm run test:browser",
    "playwright": "npm install --no-save --no-audit --no-fund playwright@1.58.0",
    "site": "node cli/serve-site.js"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "marked": "^18.2.1"
  }
}
